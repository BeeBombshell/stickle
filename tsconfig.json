{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*", ".wxt/wxt.d.ts"],
  "exclude": ["dashboard", "node_modules", "dist", ".wxt/output", ".output"]
}
