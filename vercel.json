{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".output/chrome-mv3",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/landing", "destination": "/index.html" },
    { "source": "/landing.html", "destination": "/index.html" },
    { "source": "/waitlist", "destination": "/waitlist.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" }
  ]
}
